<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <!-- A no-title-bar platform theme (present since API 1) so the app draws its own
             dark top bar instead of a system title bar on Gingerbread or a Material
             ActionBar on modern Android. -->


        <!-- HA4O only ever speaks plain http/ws to a local Home Assistant; API 28+ blocks
             cleartext by default, so the modern build needs it explicitly allowed. The
             attribute is ignored on Gingerbread. -->

        <!-- Launcher entry. Redirects to onboarding on first run (no token yet).
             android:exported must be explicit once targetSdk >= 31 (the modern flavor). -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:label="@string/app_name"
            android:exported="false"/>
    </application>
</manifest>
